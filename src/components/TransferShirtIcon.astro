---
interface Props {
  placement?: "left-chest" | "full-front" | "full-back" | "sleeve" | "custom";
  color?: string;
  size?: number;
}
const { placement = "full-front", color = "#f8fafc", size = 64 } = Astro.props;
const isSleeve = placement === "sleeve";
const marker = placement === "left-chest" ? { x: 39, y: 33, w: 11, h: 11 } :
  placement === "full-back" ? { x: 32, y: 35, w: 35, h: 39 } :
  placement === "custom" ? { x: 40, y: 45, w: 20, h: 20 } :
  placement === "sleeve" ? { x: 12, y: 39, w: 13, h: 13 } :
  { x: 34, y: 36, w: 32, h: 34 };
---
<svg width={size} height={size} viewBox="0 0 100 100" aria-hidden="true" class="shrink-0" xmlns="http://www.w3.org/2000/svg">
  <path d="M30 15 39 10 Q50 22 61 10 L70 15 92 30 79 55 69 49 69 90 31 90 31 49 21 55 8 30Z" fill={color} stroke="#64748b" stroke-width="3" stroke-linejoin="round" />
  <path d="M39 10 Q50 29 61 10" fill="none" stroke="#94a3b8" stroke-width="2.5" />
  {placement === "custom" ? <circle cx="50" cy="55" r="13" fill="none" stroke="#0891b2" stroke-width="3" stroke-dasharray="4 4" /> : <rect x={marker.x} y={marker.y} width={marker.w} height={marker.h} rx="2.5" fill="#06b6d4" fill-opacity=".72" stroke="#0e7490" stroke-width="1.5" stroke-dasharray={isSleeve ? "2 2" : undefined} />}
</svg>
