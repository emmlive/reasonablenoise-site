---
import "../styles/global.css";
import SiteAnalytics from "../components/SiteAnalytics.astro";
const concepts = [
  {name:"Spirit",label:"School pride",word:"SPIRIT",detail:"CLASS OF 2026 · WILDCATS PRIDE",tone:"navy",note:"Customize wording, colors and graduation year."},
  {name:"Legends",label:"Senior class",word:"LEGENDS",detail:"SENIOR YEAR · EST. 2024",tone:"gold",note:"Add an approved mascot or original school emblem."},
  {name:"Victory",label:"Champions",word:"VICTORY",detail:"CLASS OF 2025 · CHAMPIONS",tone:"navy",note:"Personalize championship language only when accurate."},
  {name:"Ambition",label:"Bold type",word:"AMBITION",detail:"CREATE YOUR OWN PATH",tone:"mint",note:"Original typography with optional accent artwork."}
];
---
<html lang="en">
<head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width"/>
<title>Varsity & Creative Shirt Concepts | ReasonableNoise</title>
<meta name="robots" content="noindex, nofollow"/>
<meta name="description" content="Explore original varsity-inspired and creative custom shirt concepts. Request a proof and quote before any payment."/>
<link rel="icon" type="image/png" href="/assets/rn-logo.png"/>
</head>
<body class="min-h-screen bg-[#070b12] text-white antialiased">
<header class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-6">
<a href="/" class="flex items-center gap-3 font-semibold"><img src="/assets/rn-logo.png" alt="" class="h-12 w-12 object-contain"/>ReasonableNoise</a>
<nav aria-label="Design collections" class="flex flex-wrap items-center gap-4 text-sm text-white/70"><a href="/dtf-shirts" class="hover:text-white">Shirt printing</a><a href="/bring-your-design" class="hover:text-white">Bring Your Design</a><a href="/" class="hover:text-white">Home</a></nav>
</header>
<main>
<section class="mx-auto max-w-7xl px-5 pb-16 pt-16 md:pt-24">
<p class="text-xs font-bold uppercase tracking-[.3em] text-amber-300">ReasonableNoise / New concepts</p>
<h1 class="mt-5 max-w-4xl text-5xl font-black tracking-[-.06em] sm:text-7xl">School spirit.<br/><span class="text-amber-300">Your signature.</span></h1>
<p class="mt-7 max-w-2xl text-lg leading-8 text-white/65">Varsity-inspired apparel for classes, clubs, teams and creators. These are editable typography concepts—not licensed school merchandise or approved print proofs.</p>
<div class="mt-8 flex flex-wrap gap-3"><a href="#varsity" class="rounded-full bg-amber-300 px-6 py-3 font-bold text-slate-950">Explore concepts</a><a href="/bring-your-design" class="rounded-full border border-white/30 px-6 py-3 font-semibold">Bring Your Design (BYD)</a></div>
</section>
<section class="mx-auto max-w-7xl px-5 pb-24" id="varsity">
<div class="mb-7 flex flex-wrap items-end justify-between gap-4"><div><p class="text-sm uppercase tracking-widest text-white/45">Varsity / 01</p><h2 class="mt-2 text-3xl font-bold">Varsity & school spirit</h2></div><p class="max-w-sm text-sm text-white/55">Concepts inspired by the submitted samples; artwork and school identity require independent review.</p></div>
<div class="grid gap-6 md:grid-cols-2">
{concepts.map((item)=>(
<article class="overflow-hidden rounded-[2rem] border border-white/10 bg-white/[.06]">
<div class="relative overflow-hidden bg-slate-900">
<img src={`/shirt-concepts/${item.name.toLowerCase()}.svg`} alt={`Original ${item.name} varsity-style vector illustration with an abstract emblem; concept only, not a print proof`} width="1200" height="850" loading="lazy" class="block h-auto w-full" />
<span class="absolute bottom-3 left-3 rounded-full border border-white/20 bg-black/70 px-3 py-1 text-[11px] font-bold uppercase tracking-widest text-white backdrop-blur">Digital concept · Not print ready</span>
</div>
<div class="p-6"><p class="text-xs uppercase tracking-widest text-amber-300">{item.label}</p><h3 class="mt-2 text-2xl font-bold">{item.name} collection</h3><p class="mt-2 text-sm text-white/60">{item.note}</p><a class="mt-5 inline-block rounded-full border border-white/25 px-5 py-2 text-sm font-semibold hover:border-white" href="/contact?topic=dtf">Request customized quote</a></div>
</article>
))}
</div>
</section>
<section class="border-y border-white/10 bg-[#0f1e20] px-5 py-20" id="creative"><div class="mx-auto grid max-w-7xl gap-9 md:grid-cols-2 md:items-center">
<div><p class="text-sm font-bold uppercase tracking-widest text-emerald-300">Creative / 02</p><h2 class="mt-4 text-4xl font-black tracking-tight">Illustrated names. Original characters. Big personality.</h2><p class="mt-5 leading-7 text-white/60">The supplied panda typography references point toward a playful original mascot collection. The gallery now includes two new original illustrated wordmark concepts, Forest Club and Sunset Pals. Both need physical print proofs and rights review before they're offered as merchandise.</p><a href="/bring-your-design" class="mt-7 inline-block rounded-full bg-white px-6 py-3 font-bold text-slate-950">Start a creative design request</a></div>
<div class="grid gap-4 sm:grid-cols-2 md:grid-cols-1">
<figure class="overflow-hidden rounded-[1.5rem] border border-emerald-300/20 bg-[#15342d]">
<img src="/shirt-concepts/forest-club.svg" width="1200" height="850" loading="lazy" class="h-auto w-full" alt="Forest Club original geometric panda and evergreen landscape illustration concept" />
<figcaption class="px-4 py-3 text-xs text-white/60">Forest Club · Original vector concept · Print proof pending</figcaption>
</figure>
<figure class="overflow-hidden rounded-[1.5rem] border border-emerald-300/20 bg-[#15342d]">
<img src="/shirt-concepts/sunset-pals.svg" width="1200" height="850" loading="lazy" class="h-auto w-full" alt="Sunset Pals original geometric panda and warm sunset landscape concept" />
<figcaption class="px-4 py-3 text-xs text-white/60">Sunset Pals · Original vector concept · Print proof pending</figcaption>
</figure></div>
</div></section>
<section class="mx-auto max-w-7xl px-5 py-20"><h2 class="text-3xl font-bold">Before any printing or checkout</h2><div class="mt-8 grid gap-4 md:grid-cols-3">{["Artwork rights & school trademarks","Transparent, high-resolution print file","Garment, sizing, pricing and proof approval"].map((x,i)=><div class="rounded-2xl border border-white/10 bg-white/5 p-5"><span class="text-sm text-amber-300">0{i+1}</span><p class="mt-2 font-semibold">{x}</p></div>)}</div><p class="mt-6 max-w-3xl text-sm leading-6 text-white/55">Artwork shown here is original scalable SVG concept styling, not a reproduction of uploaded samples and not a production print file. Team names and third-party marks require authorization. No payment is taken on this concept page; requests go through the existing quote-review workflow.</p></section>
</main>
<footer class="border-t border-white/10 px-5 py-8 text-center text-sm text-white/50">ReasonableNoise · Design concepts only · <a href="/privacy" class="underline">Privacy</a></footer>
<SiteAnalytics/>
</body></html>