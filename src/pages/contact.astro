---
import "../styles/global.css";
import SiteAnalytics from "../components/SiteAnalytics.astro";
import WhatsAppChat from "../components/WhatsAppChat.astro";
const dtfTurnstileSiteKey = import.meta.env.PUBLIC_DTF_TURNSTILE_SITE_KEY || "";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Contact ReasonableNoise | Sticker Orders & Custom Decals</title>
    <meta name="description" content="Contact ReasonableNoise for USDOT stickers, custom decals, vehicle lettering, artwork help, pickup, shipping, and order questions." />
    <link rel="icon" type="image/png" href="/assets/rn-logo.png" />
    <link rel="shortcut icon" type="image/png" href="/assets/rn-logo.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <script is:inline id="rn-turnstile-script" src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>

    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://reasonablenoise.com/contact/" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ReasonableNoise" />
    <meta property="og:title" content="Contact ReasonableNoise | Sticker Orders & Custom Decals" />
    <meta property="og:description" content="Contact ReasonableNoise for USDOT stickers, custom decals, vehicle lettering, artwork help, pickup, shipping, and order questions." />
    <meta property="og:url" content="https://reasonablenoise.com/contact/" />
    <meta property="og:image" content="https://reasonablenoise.com/assets/rn-logo.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Contact ReasonableNoise | Sticker Orders & Custom Decals" />
    <meta name="twitter:description" content="Contact ReasonableNoise for USDOT stickers, custom decals, vehicle lettering, artwork help, pickup, shipping, and order questions." />
    <meta name="twitter:image" content="https://reasonablenoise.com/assets/rn-logo.png" />
  </head>

  <body class="min-h-screen bg-[#050608] text-white antialiased">
    <main class="relative overflow-hidden">
      <div class="absolute inset-0 -z-10">
        <div class="absolute left-1/2 top-0 h-[520px] w-[900px] -translate-x-1/2 rounded-full bg-cyan-500/15 blur-[120px]"></div>
      </div>

      <header class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-5 sm:px-6">
        <a href="/" class="flex items-center gap-3">
          <div class="flex h-16 w-16 items-center justify-center rounded-3xl bg-black p-2 shadow-lg shadow-black/30 ring-1 ring-white/10">
            <img src="/assets/rn-logo.png" alt="ReasonableNoise logo" class="h-full w-full object-contain" />
          </div>
          <div>
            <p class="text-sm font-semibold tracking-wide">ReasonableNoise</p>
            <p class="text-xs text-white/50">Premium sticker printing</p>
          </div>
        </a>

        <nav class="hidden items-center gap-8 text-sm text-white/70 md:flex">
          <a class="hover:text-white" href="/">Home</a>
          <a class="hover:text-white" href="/usdot-stickers">USDOT Stickers</a>
          <a class="hover:text-white" href="/upload-design">Upload Design</a>
          <a class="text-white" href="/contact">Contact</a>
        </nav>

        <a id="contact-header-cta" href="/upload-design" class="rounded-full bg-white px-5 py-2.5 text-sm font-semibold text-black">
          Start Order
        </a>
      </header>

      <section class="mx-auto grid max-w-7xl gap-8 px-4 py-16 sm:px-6 md:grid-cols-[0.9fr_1.1fr] md:py-24">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.3em] text-cyan-300">Contact</p>
          <h1 id="contact-hero-title" class="mt-5 text-5xl font-semibold tracking-[-0.05em] md:text-7xl">
            Need help with a sticker order?
          </h1>
          <p id="contact-hero-description" class="mt-6 max-w-2xl text-lg leading-8 text-white/60">
            Send a message about USDOT stickers, custom decals, vehicle lettering, artwork upload, pickup, shipping, or DTF T-shirt order quote requests.
          </p>

          <div class="mt-10 grid gap-4">
            <a href="mailto:info@reasonablenoise.com" class="rounded-3xl border border-white/10 bg-white/[0.06] p-5 backdrop-blur transition hover:bg-white/[0.09]">
              <p class="font-semibold text-white">Email ReasonableNoise</p>
              <p class="mt-2 text-sm leading-6 text-white/55">info@reasonablenoise.com</p>
            </a>

            <a id="contact-next-step-link" href="/upload-design" class="rounded-3xl border border-white/10 bg-white/[0.06] p-5 backdrop-blur transition hover:bg-white/[0.09]">
              <p id="contact-next-step-title" class="font-semibold text-white">Ready to order?</p>
              <p id="contact-next-step-description" class="mt-2 text-sm leading-6 text-white/55">Start a secure sticker order and upload artwork.</p>
            </a>

            <div class="rounded-3xl border border-white/10 bg-white/[0.06] p-5 backdrop-blur">
              <p class="font-semibold text-white">Fast response tip</p>
              <p id="contact-fast-tip" class="mt-2 text-sm leading-6 text-white/55">Include sticker type, size, quantity, color, and whether you want pickup or shipping.</p>
            </div>
          </div>
        </div>

        <form id="contact-form" class="rounded-[2.5rem] border border-white/10 bg-white p-5 text-black shadow-2xl shadow-black/40 sm:p-8">
          <div class="mb-8">
            <p class="text-sm font-bold uppercase tracking-[0.3em] text-black/40">Message</p>
            <h2 id="contact-form-title" class="mt-3 text-3xl font-semibold tracking-[-0.04em]">Send a contact request.</h2>
            <p id="contact-form-intro" class="mt-3 text-sm leading-6 text-black/55">
              We’ll receive your message by email and follow up as soon as possible.
            </p>
            <p id="contact-message" class="mt-4 hidden rounded-2xl border border-black/10 bg-black/[0.04] px-4 py-3 text-sm font-semibold"></p>
          </div>

          <div class="grid gap-4 md:grid-cols-2">
            <label class="grid gap-2">
              <span class="text-sm font-semibold text-black/70">Name *</span>
              <input name="name" required class="rounded-2xl border border-black/10 bg-black/[0.03] px-4 py-3 outline-none focus:border-black/30" placeholder="Full name" />
            </label>

            <label class="grid gap-2">
              <span class="text-sm font-semibold text-black/70">Email *</span>
              <input name="email" required type="email" class="rounded-2xl border border-black/10 bg-black/[0.03] px-4 py-3 outline-none focus:border-black/30" placeholder="you@email.com" />
            </label>

            <label class="grid gap-2">
              <span class="text-sm font-semibold text-black/70">Phone</span>
              <input name="phone" class="rounded-2xl border border-black/10 bg-black/[0.03] px-4 py-3 outline-none focus:border-black/30" placeholder="Phone number" />
            </label>

            <label class="grid gap-2">
              <span class="text-sm font-semibold text-black/70">Topic</span>
              <select name="contactType" class="rounded-2xl border border-black/10 bg-black/[0.03] px-4 py-3 outline-none focus:border-black/30">
                <option>Sticker order question</option>
                <option>USDOT sticker quote</option>
                <option>Custom decal quote</option>
                <option>Artwork / design help</option>
                <option>Pickup or shipping question</option>
                <option>DTF T-shirt order quote</option>
                <option>DTF - I will bring my own shirts</option>
                <option>Other</option>
              </select>
            </label>

            <div data-rn-dtf-detail-panel data-rn-dtf-detail-panel-contact class="hidden rounded-3xl border border-cyan-200/70 bg-cyan-50 p-4 md:col-span-2">
              <div class="mb-4">
                <p class="text-sm font-black uppercase tracking-[0.2em] text-cyan-800">DTF order details</p>
                <p class="mt-2 text-sm leading-6 text-black/60">Add the shirt details so we can quote the order accurately.</p>
              </div>

              <div class="grid gap-4 md:grid-cols-2">
                <label class="grid gap-2">
                  <span class="text-sm font-semibold text-black/70">Shirt source</span>
                  <select name="dtfShirtSource" class="rounded-2xl border border-black/10 bg-white px-4 py-3 outline-none focus:border-black/30">
                    <option>ReasonableNoise supplies shirts</option>
                    <option>Customer brings shirts</option>
                    <option>Not sure yet</option>
                  </select>
                </label>

                <label class="grid gap-2">
                  <span class="text-sm font-semibold text-black/70">Quantity</span>
                  <input name="dtfQuantity" type="number" min="1" class="rounded-2xl border border-black/10 bg-white px-4 py-3 outline-none focus:border-black/30" placeholder="Example: 12" />
                </label>

                <label class="grid gap-2">
                  <span class="text-sm font-semibold text-black/70">Shirt color</span>
                  <input name="dtfShirtColor" class="rounded-2xl border border-black/10 bg-white px-4 py-3 outline-none focus:border-black/30" placeholder="Black, white, assorted..." />
                </label>

                <label class="grid gap-2">
                  <span class="text-sm font-semibold text-black/70">Print placement</span>
                  <select name="dtfPrintPlacement" class="rounded-2xl border border-black/10 bg-white px-4 py-3 outline-none focus:border-black/30">
                    <option>Front</option>
                    <option>Back</option>
                    <option>Front + Back</option>
                    <option>Sleeve / custom placement</option>
                    <option>Not sure yet</option>
                  </select>
                </label>

                <label class="grid gap-2 md:col-span-2">
                  <span class="text-sm font-semibold text-black/70">Deadline</span>
                  <input name="dtfDeadline" class="rounded-2xl border border-black/10 bg-white px-4 py-3 outline-none focus:border-black/30" placeholder="Needed by date or flexible" />
                </label>
              </div>
              <label class="mt-5 grid gap-2">
                <span class="text-sm font-semibold text-black/70">DTF artwork or reference (optional)</span>
                <input name="artwork" type="file" accept=".png,.jpg,.jpeg,.webp,.pdf,.svg,.ai,.eps,.psd" disabled={!dtfTurnstileSiteKey} class="w-full rounded-2xl border border-dashed border-cyan-300/70 bg-white p-4 text-sm text-black/70 disabled:cursor-not-allowed disabled:opacity-50" />
                <span class="text-xs leading-5 text-black/55">One file, maximum 15 MB. PNG, JPG, WEBP, PDF, SVG, AI, EPS or PSD. Stored privately with your quote request, not through sticker checkout.</span>
                {dtfTurnstileSiteKey ? (
                  <div id="rn-dtf-turnstile" data-sitekey={dtfTurnstileSiteKey} class="mt-3 min-h-16"></div>
                ) : (
                  <span class="rounded-xl border border-amber-200 bg-amber-50 p-3 text-xs font-semibold text-amber-900">Artwork uploads are temporarily unavailable while security verification is configured. You can still request a quote without artwork.</span>
                )}
              </label>
            </div>


            <label class="grid gap-2 md:col-span-2">
              <span class="text-sm font-semibold text-black/70">Message *</span>
              <textarea name="message" required class="min-h-40 rounded-2xl border border-black/10 bg-black/[0.03] px-4 py-3 outline-none focus:border-black/30" placeholder="Tell us what you need."></textarea>
            </label>
          </div>

          <button id="contact-button" type="submit" class="mt-6 w-full rounded-full bg-black px-6 py-4 text-sm font-bold text-white shadow-xl shadow-black/20 transition hover:bg-black/90">
            Send Message
          </button>

          <p class="mt-4 text-center text-xs leading-5 text-black/45">
            You can also email info@reasonablenoise.com directly.
          </p>
        </form>
      </section>

      <footer class="mx-auto flex max-w-7xl flex-col gap-4 px-4 py-10 text-sm text-white/45 sm:px-6 md:flex-row md:items-center md:justify-between">
        <p>© 2026 ReasonableNoise. Premium sticker printing.</p>
        <div class="flex flex-wrap gap-5">
          <a href="/" class="hover:text-white">Home</a>
          <a href="/usdot-stickers" class="hover:text-white">USDOT Stickers</a>
          <a href="/upload-design" class="hover:text-white">Upload Design</a>
          <a href="/privacy" class="hover:text-white">Privacy</a>
          <a href="/terms" class="hover:text-white">Terms</a>
        </div>
      </footer>
    </main>

    <script>
      const form = document.getElementById("contact-form");
      const button = document.getElementById("contact-button");
      const message = document.getElementById("contact-message");
      const dtfPanel = form?.querySelector("[data-rn-dtf-detail-panel]");
      const heroTitle = document.getElementById("contact-hero-title");
      const heroDescription = document.getElementById("contact-hero-description");
      const nextStepLink = document.getElementById("contact-next-step-link");
      const nextStepTitle = document.getElementById("contact-next-step-title");
      const nextStepDescription = document.getElementById("contact-next-step-description");
      const fastTip = document.getElementById("contact-fast-tip");
      const headerCta = document.getElementById("contact-header-cta");
      const formTitle = document.getElementById("contact-form-title");
      const formIntro = document.getElementById("contact-form-intro");

      function isDtfContact(value) {
        return String(value || "").toLowerCase().includes("dtf");
      }

      let dtfChallengeWidgetId = null;

      function renderDtfChallenge() {
        const container = document.getElementById("rn-dtf-turnstile");
        if (
          !container ||
          dtfChallengeWidgetId !== null ||
          !window.turnstile?.render ||
          !isDtfContact(form?.elements.contactType?.value)
        ) return;

        dtfChallengeWidgetId = window.turnstile.render(container, {
          sitekey: container.dataset.sitekey,
          action: "dtf_artwork",
          theme: "light",
          size: "flexible",
        });
      }

      function updateDtfPanel() {
        const contactType = form?.elements.contactType;
        if (!dtfPanel || !contactType) return;
        const dtfSelected = isDtfContact(contactType.value);
        dtfPanel.classList.toggle("hidden", !dtfSelected);
        if (dtfSelected) renderDtfChallenge();

        if (heroTitle) {
          heroTitle.textContent = dtfSelected
            ? "Need custom T-shirts printed?"
            : "Need help with a sticker order?";
        }
        if (heroDescription) {
          heroDescription.textContent = dtfSelected
            ? "Request a DTF shirt quote and attach your artwork below. We confirm shirt source, quantity, print placement, timing, and pricing before payment."
            : "Send a message about USDOT stickers, custom decals, vehicle lettering, artwork upload, pickup, shipping, or DTF T-shirt order quote requests.";
        }
        if (nextStepLink) {
          nextStepLink.href = dtfSelected ? "#contact-form" : "/upload-design";
        }
        if (nextStepTitle) {
          nextStepTitle.textContent = dtfSelected ? "Request a DTF quote" : "Ready to order?";
        }
        if (nextStepDescription) {
          nextStepDescription.textContent = dtfSelected
            ? "Send your shirt details and artwork on this page. No payment is required to request a quote."
            : "Start a secure sticker order and upload artwork.";
        }
        if (fastTip) {
          fastTip.textContent = dtfSelected
            ? "Include quantity, shirt source, color, print placement, deadline, and artwork if available."
            : "Include sticker type, size, quantity, color, and whether you want pickup or shipping.";
        }
        if (headerCta) {
          headerCta.href = dtfSelected ? "#contact-form" : "/upload-design";
          headerCta.textContent = dtfSelected ? "Request DTF Quote" : "Start Order";
        }
        if (formTitle) {
          formTitle.textContent = dtfSelected ? "Request a DTF printing quote." : "Send a contact request.";
        }
        if (formIntro) {
          formIntro.textContent = dtfSelected
            ? "Send your shirt details and optional artwork for review. We'll confirm pricing before requesting payment."
            : "We’ll receive your message by email and follow up as soon as possible.";
        }
        if (button && !button.disabled && button.textContent !== "Message Sent" && button.textContent !== "Quote Submitted") {
          button.textContent = dtfSelected ? "Request DTF Quote" : "Send Message";
        }
      }

      function getDtfDetails(formData, contactType) {
        if (!isDtfContact(contactType)) return [];

        return [
          "Shirt source: " + String(formData.get("dtfShirtSource") || ""),
          "Quantity: " + String(formData.get("dtfQuantity") || ""),
          "Shirt color: " + String(formData.get("dtfShirtColor") || ""),
          "Print placement: " + String(formData.get("dtfPrintPlacement") || ""),
          "Deadline: " + String(formData.get("dtfDeadline") || ""),
        ].filter((line) => !line.endsWith(": "));
      }


      function showContactMessage(text, isError = false) {
        if (!message) return;
        message.textContent = text;
        message.classList.remove("hidden");
        message.classList.toggle("text-red-600", isError);
        message.classList.toggle("text-emerald-700", !isError);
      }

      function applyContactPrefill() {
        const params = new URLSearchParams(window.location.search);
        const topic = params.get("topic");

        if (topic !== "dtf" || !form) return;

        const contactType = form.elements.contactType;
        const messageField = form.elements.message;

        if (contactType) {
          contactType.value = "DTF T-shirt order quote";
        }

        if (messageField && !messageField.value) {
          messageField.placeholder = "Tell us about your DTF shirt request: quantity, shirt color, whether you are bringing your own shirts, print size, front/back print, artwork status, and deadline.";
        }

        showContactMessage("DTF order quote selected. Send your shirt details and we’ll follow up.", false);
      }

      form?.elements.contactType?.addEventListener("change", updateDtfPanel);
      document.getElementById("rn-turnstile-script")?.addEventListener("load", renderDtfChallenge);
      window.addEventListener("load", renderDtfChallenge);


      applyContactPrefill();


      updateDtfPanel();

      form?.addEventListener("submit", async (event) => {
        event.preventDefault();

        button.disabled = true;
        button.textContent = isDtfContact(form?.elements.contactType?.value) ? "Submitting DTF quote..." : "Sending message...";
        showContactMessage("Sending your message...");

        const formData = new FormData(form);


        const payload = Object.fromEntries(formData.entries());


        const dtfDetails = getDtfDetails(formData, payload.contactType || "");



        if (dtfDetails.length) {


          payload.message = [


            payload.message || "",


            "",


            "DTF order details",


            ...dtfDetails,


          ].join("\n").trim();


        }

        try {
          const isDtf = isDtfContact(payload.contactType || "");
          const artwork = isDtf ? formData.get("artwork") : null;
          if (artwork && typeof artwork !== "string" && artwork.name && artwork.size > 15 * 1024 * 1024) {
            throw new Error("Artwork must be 15 MB or less.");
          }
          if (
            artwork && typeof artwork !== "string" && artwork.name &&
            !String(formData.get("cf-turnstile-response") || "")
          ) {
            throw new Error("Please complete the artwork security check before uploading.");
          }

          let requestOptions;
          if (isDtf) {
            // Send artwork and quote details in one multipart submission.
            formData.set("message", payload.message);
            requestOptions = { method: "POST", body: formData };
          } else {
            delete payload.artwork;
            requestOptions = {
              method: "POST",
              headers: { "content-type": "application/json" },
              body: JSON.stringify(payload),
            };
          }

          const response = await fetch("/api/contact", requestOptions);

          const data = await response.json();

          if (!response.ok || !data.success) {
            throw new Error(data.error || "Unable to send message.");
          }

          window.rnTrack?.("contact_form_success", {
            label: "Contact form sent",
            metadata: {
              contactType: payload.contactType || "",
            },
          });

          form.reset();
          applyContactPrefill();
          updateDtfPanel();
          const quoteLabel = data.quoteReference ? `DTF quote ${data.quoteReference} received. ` : "";
          showContactMessage(quoteLabel + "Message sent. We’ll follow up before any DTF payment.");
          button.textContent = data.quoteReference ? "Quote Submitted" : "Message Sent";
        } catch (error) {
          if (dtfChallengeWidgetId !== null) window.turnstile?.reset?.(dtfChallengeWidgetId);
          showContactMessage(error.message || "Unable to send message.", true);
          button.disabled = false;
          button.textContent = isDtfContact(form?.elements.contactType?.value) ? "Request DTF Quote" : "Send Message";
        }
      });
    </script>

    <WhatsAppChat />
      <SiteAnalytics />
  </body>
</html>

