---
import "../styles/global.css";
import SiteAnalytics from "../components/SiteAnalytics.astro";
import WhatsAppChat from "../components/WhatsAppChat.astro";
import QuickQuote from "../components/QuickQuote.astro";
import BrandAssurance from "../components/BrandAssurance.astro";
import { printShopItems } from "../data/printShopCatalog.js";

const featured = [
  printShopItems.find((item) => item.id === "usdot-sticker-pair"),
  printShopItems.find((item) => item.id === "custom-business-decals"),
  printShopItems.find((item) => item.id === "truck-door-lettering"),
].filter(Boolean);
const homeSeoFaqs = [
  {
    question: "What does ReasonableNoise make?",
    answer: "ReasonableNoise makes USDOT stickers, custom business decals, truck door lettering, fleet lettering, logo stickers, and custom DTF shirt requests.",
  },
  {
    question: "Can I upload a logo or artwork?",
    answer: "Yes. You can share artwork or reference files when starting a sticker or decal order, or request a DTF shirt quote.",
  },
  {
    question: "Can I choose shipping or local pickup?",
    answer: "For sticker and decal orders, choose local pickup or shipping and review the checkout amount before payment.",
  },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ReasonableNoise | USDOT Stickers, Custom Decals &amp; Print Shop</title>
    <meta name="description" content="Shop USDOT sticker sets, custom decals, vehicle lettering and DTF shirt quotes. Clear pricing guides, artwork upload, pickup or shipping." />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://reasonablenoise.com/" />
    <link rel="icon" type="image/png" href="/assets/rn-logo.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ReasonableNoise" />
    <meta property="og:title" content="ReasonableNoise | USDOT Stickers, Custom Decals & Print Shop" />
    <meta property="og:description" content="Discover USDOT sticker sets, custom decals and print-shop ordering with clear next steps." />
    <meta property="og:url" content="https://reasonablenoise.com/" />
    <meta property="og:image" content="https://reasonablenoise.com/assets/rn-logo.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="ReasonableNoise Print Shop" />
    <meta name="twitter:description" content="Custom printing made clear, from your idea to your order." />
    <meta name="twitter:image" content="https://reasonablenoise.com/assets/rn-logo.png" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org", "@type": "Organization",
      name: "ReasonableNoise", url: "https://reasonablenoise.com",
      logo: "https://reasonablenoise.com/assets/rn-logo.png",
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org", "@type": "FAQPage",
      mainEntity: homeSeoFaqs.map((item) => ({
        "@type": "Question", name: item.question,
        acceptedAnswer: { "@type": "Answer", text: item.answer },
      })),
    })} />
  </head>
  <body class="min-h-screen bg-[#F9FAF8] text-[#162234] antialiased">
    <div class="border-b border-[#E6EBE9] bg-white">
      <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-2 px-4 py-2 text-xs font-medium text-slate-600 sm:px-6">
        <span>Thoughtful printing for working vehicles &amp; businesses</span>
        <a href="/contact" class="font-semibold text-blue-700 underline-offset-4 hover:underline">Questions? Contact us</a>
      </div>
    </div>
    <header class="border-b border-[#E6EBE9] bg-white/95">
      <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-4 px-4 py-4 sm:px-6">
        <a href="/" class="flex items-center gap-3" aria-label="ReasonableNoise home">
          <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-black p-2">
            <img src="/assets/rn-logo.png" alt="" width="44" height="44" class="h-full w-full object-contain" />
          </span>
          <span>
            <span class="block text-base font-extrabold tracking-tight">ReasonableNoise</span>
            <span class="block text-xs font-medium text-slate-500">Custom print shop</span>
          </span>
        </a>
        <nav aria-label="Main navigation" class="flex flex-wrap items-center gap-3 text-sm font-semibold text-slate-700 sm:gap-6">
          <a class="rounded-md py-2 hover:text-blue-700 focus-visible:outline-2 focus-visible:outline-blue-700" href="/shop">Shop products</a>
          <a class="hidden rounded-md py-2 hover:text-blue-700 focus-visible:outline-2 focus-visible:outline-blue-700 sm:inline" href="/usdot-stickers">USDOT stickers</a>
          <a class="hidden rounded-md py-2 hover:text-blue-700 focus-visible:outline-2 focus-visible:outline-blue-700 md:inline" href="/dtf-shirts">DTF shirts</a>
          <a href="/upload-design" class="rounded-full bg-[#175CD3] px-4 py-3 text-center text-white shadow-sm transition hover:bg-[#1248A8] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-700 sm:px-5">Start an order</a>
        </nav>
      </div>
    </header>
    <main>
      <section class="relative overflow-hidden border-b border-[#E6EBE9] bg-gradient-to-br from-[#F8FAFD] via-white to-[#F1F5FB]">
        <div class="mx-auto grid max-w-7xl items-center gap-10 px-4 py-14 sm:px-6 sm:py-20 lg:grid-cols-2 lg:gap-14 lg:py-24">
          <div>
            <p class="inline-flex rounded-full border border-[#C7D7F0] bg-[#EAF2FE] px-4 py-2 text-xs font-bold uppercase tracking-[0.14em] text-[#175CD3]">Made for businesses that move</p>
            <h1 class="mt-7 max-w-2xl text-4xl font-extrabold leading-[1.07] tracking-[-0.045em] text-[#142035] sm:text-5xl lg:text-6xl xl:text-7xl">
              Your next print job, <span class="text-[#175CD3]">made simple.</span>
            </h1>
            <p class="mt-6 max-w-xl text-lg leading-8 text-slate-600">Custom printing made clear, from your idea to your order. Get USDOT stickers, business decals and vehicle lettering with an easy way to share your details.</p>
            <div class="mt-8 flex flex-col flex-wrap gap-3 sm:flex-row">
              <a href="/shop" class="rounded-full bg-[#175CD3] px-7 py-4 text-center text-sm font-bold text-white shadow-lg shadow-blue-700/10 transition hover:bg-[#1248A8] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-700">Explore products</a>
              <a href="#quick-quote" data-rn-primary-quote-cta class="rounded-full border border-[#CAD6E5] bg-white px-7 py-4 text-center text-sm font-bold text-slate-900 transition hover:border-[#175CD3] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-700">Get Quote First</a>
              <a href="/upload-design" class="rounded-full border border-[#CAD6E5] bg-white px-7 py-4 text-center text-sm font-bold text-slate-900 transition hover:border-[#175CD3] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-700">Upload design</a>
            </div>
            <div class="mt-9 flex flex-wrap items-center gap-x-6 gap-y-3 text-sm font-medium text-slate-600">
              <span class="flex items-center gap-2"><span class="text-[#175CD3]" aria-hidden="true">✓</span> Clear price guides</span>
              <span class="flex items-center gap-2"><span class="text-[#175CD3]" aria-hidden="true">✓</span> Pickup or shipping</span>
              <span class="flex items-center gap-2"><span class="text-[#175CD3]" aria-hidden="true">✓</span> Your own artwork welcome</span>
            </div>
          </div>
          <div class="relative rounded-[2rem] border border-[#DDE6F2] bg-white p-5 shadow-[0_25px_80px_rgba(32,51,81,0.10)] sm:p-7">
            <div class="mb-5 flex items-center justify-between gap-2">
              <div><p class="text-xs font-bold uppercase tracking-[0.14em] text-blue-700">Print preview</p><p class="mt-1 text-lg font-bold">Commercial vehicle decals</p></div>
              <span class="rounded-full bg-[#EAF2FE] px-3 py-1 text-xs font-semibold text-blue-700">Sample artwork</span>
            </div>
            <div class="relative rounded-[1.5rem] bg-[#ECF2F8] p-6 sm:p-9">
              <div class="mx-auto max-w-md rotate-[-2deg] rounded-xl bg-white p-6 text-[#111827] shadow-xl ring-1 ring-[#D6DFE9] sm:p-8">
                <p class="text-xs font-extrabold tracking-[0.18em]">YOUR BUSINESS NAME</p>
                <p class="mt-7 text-3xl font-black tracking-tight sm:text-5xl">USDOT</p>
                <p class="text-4xl font-black tracking-[-0.05em] sm:text-6xl">1234567</p>
                <p class="mt-7 text-xs font-bold uppercase tracking-[0.19em] text-slate-500">Custom vehicle lettering</p>
              </div>
            </div>
            <div class="mt-5 grid grid-cols-2 gap-3 text-sm">
              <div class="rounded-xl bg-[#F7F9FC] p-4"><p class="font-bold">USDOT pairs</p><p class="mt-1 text-slate-500">Price guide from $29</p></div>
              <div class="rounded-xl bg-[#F7F9FC] p-4"><p class="font-bold">Custom decals</p><p class="mt-1 text-slate-500">Made for your artwork</p></div>
            </div>
            <p class="mt-4 text-xs leading-5 text-slate-500">Illustrative design only. Final artwork, pricing and availability are reviewed during ordering.</p>
          </div>
        </div>
      </section>

      <section id="products" class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20">
        <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="text-xs font-extrabold uppercase tracking-[0.16em] text-blue-700">Browse the print shop</p>
            <h2 class="mt-3 text-3xl font-extrabold tracking-tight sm:text-4xl">Start with what you need printed.</h2>
            <p class="mt-3 max-w-xl leading-7 text-slate-600">Explore clear product options. Final availability is confirmed when you order.</p>
          </div>
          <a href="/shop" class="rounded-full border border-slate-300 bg-white px-5 py-3 text-sm font-bold text-blue-700 hover:border-blue-500">View all products →</a>
        </div>
        <div class="grid gap-5 md:grid-cols-3">
          {featured.map((item, index) => (
            <article class="flex min-w-0 flex-col overflow-hidden rounded-[1.6rem] border border-[#E2E9F1] bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-lg">
              <div class:list={["relative flex h-40 items-center justify-center p-6", index === 0 ? "bg-[#DDEBFA]" : index === 1 ? "bg-[#E8F0EA]" : "bg-[#EDF0F6]"]}>
                <div class="rounded-xl border-2 border-slate-800 bg-white px-8 py-5 text-center shadow-lg">
                  <p class="text-xs font-black uppercase tracking-[0.18em] text-slate-500">{index === 1 ? "YOUR BRAND" : index === 2 ? "YOUR COMPANY" : "VEHICLE DECAL"}</p>
                  <p class="mt-2 text-2xl font-black tracking-[-0.04em] text-slate-900">{index === 0 ? "USDOT 1234567" : index === 1 ? "YOUR LOGO" : "TRUCK LETTERING"}</p>
                </div>
              </div>
              <div class="flex flex-1 flex-col p-6">
                <p class="text-xs font-bold uppercase tracking-[0.1em] text-slate-500">{item.category}</p>
                <h3 class="mt-2 text-xl font-bold">{item.title}</h3>
                <p class="mt-3 flex-1 text-sm leading-6 text-slate-600">{item.description}</p>
                <div class="mt-6 flex flex-wrap items-end justify-between gap-3">
                  <div><p class="text-xs text-slate-500">Price guide</p><p class="mt-1 text-2xl font-extrabold">{item.price}</p></div>
                  <a href="/shop" class="rounded-full bg-[#175CD3] px-5 py-3 text-sm font-bold text-white hover:bg-[#1248A8]">View details</a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="border-y border-[#E1E9E5] bg-[#F0F5F1]">
        <div class="mx-auto grid max-w-7xl gap-6 px-4 py-14 sm:px-6 lg:grid-cols-2 lg:gap-14">
          <div>
            <p class="text-xs font-bold uppercase tracking-[0.16em] text-[#27664C]">Custom print jobs</p>
            <h2 class="mt-3 text-3xl font-extrabold tracking-tight sm:text-4xl">Need something a little different?</h2>
            <p class="mt-4 max-w-xl leading-7 text-slate-600">Upload artwork for custom decals, order vehicle lettering, or request a quote for fleet jobs and DTF shirts. We'll help you identify the right next step.</p>
            <div class="mt-7 flex flex-wrap gap-3">
              <a href="/upload-design" class="rounded-full bg-[#142035] px-6 py-3 text-sm font-bold text-white hover:bg-slate-700">Upload your artwork</a>
              <a href="/contact?topic=dtf" class="rounded-full border border-slate-300 bg-white px-6 py-3 text-sm font-bold text-slate-900 hover:border-[#27664C]">Request DTF quote</a>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            {[
              { title: "Truck lettering", detail: "Numbers, names & contact details" },
              { title: "Fleet branding", detail: "Matching multiple vehicles" },
              { title: "Logo stickers", detail: "Stickers from your artwork" },
              { title: "DTF shirts", detail: "Custom apparel, quoted first" },
            ].map((item) => (
              <div class="rounded-2xl border border-[#DDE8E1] bg-white p-5 shadow-sm">
                <span aria-hidden="true" class="flex h-10 w-10 items-center justify-center rounded-xl bg-[#EAF4ED] text-lg text-[#27664C]">✓</span>
                <h3 class="mt-4 font-bold">{item.title}</h3>
                <p class="mt-2 text-sm leading-6 text-slate-600">{item.detail}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20">
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-blue-700">How it works</p>
        <h2 class="mt-3 text-3xl font-extrabold tracking-tight sm:text-4xl">From idea to print, four clear steps.</h2>
        <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {[
            "Choose a product or request a quote",
            "Share your details and artwork",
            "Review pricing before payment",
            "We prepare your order for pickup or shipping",
          ].map((step, index) => (
            <div class="rounded-2xl border border-[#E1E8F1] bg-white p-6">
              <span class="text-sm font-extrabold text-blue-700">0{index + 1}</span>
              <h3 class="mt-5 text-lg font-bold leading-snug">{step}</h3>
            </div>
          ))}
        </div>
      </section>

      <section id="home-faq" class="border-y border-[#E6EBE9] bg-white">
        <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
          <p class="text-xs font-bold uppercase tracking-[0.16em] text-blue-700">Useful answers</p>
          <h2 class="mt-3 text-3xl font-extrabold tracking-tight sm:text-4xl">Print-shop questions, answered.</h2>
          <div class="mt-8 grid gap-4 md:grid-cols-3">
            {homeSeoFaqs.map((item) => (
              <article class="rounded-2xl border border-[#E5EAF0] bg-[#F9FAFC] p-6">
                <h3 class="font-bold">{item.question}</h3>
                <p class="mt-3 text-sm leading-6 text-slate-600">{item.answer}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <QuickQuote />
      <BrandAssurance theme="light" />
    </main>
    <footer class="mt-10 border-t border-[#E6EBE9] bg-white">
      <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-5 px-4 py-9 text-sm text-slate-600 sm:px-6">
        <p>© 2026 ReasonableNoise. Thoughtful printing. Clear expectations.</p>
        <nav aria-label="Footer navigation" class="flex flex-wrap gap-5">
          <a class="hover:text-blue-700" href="/shop">Shop</a>
          <a class="hover:text-blue-700" href="/usdot-stickers">USDOT stickers</a>
          <a class="hover:text-blue-700" href="/dtf-shirts">DTF shirts</a>
          <a class="hover:text-blue-700" href="/faq">FAQ</a>
          <a class="hover:text-blue-700" href="/privacy">Privacy</a>
          <a class="hover:text-blue-700" href="/terms">Terms</a>
          <a class="hover:text-blue-700" href="/contact">Contact</a>
        </nav>
      </div>
    </footer>
    <WhatsAppChat />
    <SiteAnalytics />
  </body>
</html>
